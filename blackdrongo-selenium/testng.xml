<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="BlackDrongo Cucumber Suite"
       verbose="1"
       parallel="methods"
       thread-count="4"
       data-provider-thread-count="4">
    <parameter name="browser" value="chrome"/>
    00 value="http://localhost:8080"/>
    <test name="Cucumber Tests">
        <classes>
            <class name="runner.CucumberTestNgRunner"/>
        </classes>
    </test>
    <test name="API Tests">
        <packages>
            <package name="api.tests"/>
        </packages>
    </test>
</suite>
